<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Commet"
    Manufacturer="Commet"
    Version="$(var.ProductVersion)"
    UpgradeCode="bbdb50a6-959b-4c1d-b116-64668599df1a"
    Scope="perUser">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Commet is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Commet">
        <Component Id="InstallFolderCleanup" Guid="*">
          <RegistryValue
            Root="HKCU"
            Key="Software\Commet\Installer\Folders"
            Name="InstallFolder"
            Type="integer"
            Value="1"
            KeyPath="yes" />
          <RemoveFolder
            Id="RemoveInstallFolder"
            On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CommetStartMenuFolder" Name="Commet">
        <Component Id="StartMenuShortcut" Guid="*">
          <RegistryValue
            Root="HKCU"
            Key="Software\Commet\Installer"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />

          <Shortcut
            Id="CommetShortcut"
            Name="Commet"
            Target="[INSTALLFOLDER]commet.exe"
            WorkingDirectory="INSTALLFOLDER" />

          <RemoveFolder
            Id="RemoveCommetStartMenuFolder"
            On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Commet" Level="1">
      <ComponentGroupRef Id="CommetFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>
  </Package>
</Wix>
