{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug linux",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux",
            "program": "commet/lib/main.dart",
            "toolArgs": [
                "--dart-define",
                "PLATFORM=linux",
                "--dart-define",
                "BUILD_MODE=debug"
            ],
            "preLaunchTask": "Codegen",
        },
        {
            "name": "Debug windows",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows",
            "program": "commet/lib/main.dart",
            "toolArgs": [
                "--dart-define",
                "PLATFORM=windows",
                "--dart-define",
                "BUILD_MODE=debug"
            ],
            "preLaunchTask": "Codegen",
        },
        {
            "name": "Debug web",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "program": "commet/lib/main.dart",
            "toolArgs": [
                "--dart-define",
                "PLATFORM=web",
                "--dart-define",
                "BUILD_MODE=debug",
                "--web-port",
                "36347",
                "--web-header=Cross-Origin-Opener-Policy=same-origin",
                "--web-header=Cross-Origin-Embedder-Policy=require-corp"
            ],
            "preLaunchTask": "Codegen",
        },
        {
            "name": "Debug android",
            "request": "launch",
            "type": "dart",
            "deviceId": "android-arm64",
            "program": "commet/lib/main.dart",
            "toolArgs": [
                "--dart-define",
                "PLATFORM=android",
                "--dart-define",
                "BUILD_MODE=debug",
            ],
            "env": {
                "ORG_GRADLE_PROJECT_disable-abi-filtering": "true"
            },
            "preLaunchTask": "Codegen",
        },
        {
            "name": "Debug android (google services)",
            "request": "launch",
            "type": "dart",
            "deviceId": "android-arm64",
            "program": "commet/lib/main.dart",
            "toolArgs": [
                "--dart-define",
                "PLATFORM=android",
                "--dart-define",
                "BUILD_MODE=debug",
            ],
            "env": {
                "ORG_GRADLE_PROJECT_disable-abi-filtering": "true"
            },
            "preLaunchTask": "Prepare Android Google Services Debug",
        },
    ]
}